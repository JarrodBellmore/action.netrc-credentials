{
  "name": "starter-github-action",
  "description": "A starter template for building custom GitHub Actions with TypeScript",
  "version": "0.0.0",
  "author": "",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "bundle": "npm run format:write && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "all": "npm run format:write && npm run lint && npm run test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0"
  },
  "devDependencies": {
    "@github/local-action": "^7.0.1",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  }
}
